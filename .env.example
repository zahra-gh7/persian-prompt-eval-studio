# Copy this file to .env and add your Google Gemini API key.
# This repository uses Google Gemini for Persian prompt evaluation.

GEMINI_API_KEY=your-gemini-api-key

# Optional model configuration
GEMINI_MODEL=gemini-2.5-flash
GEMINI_JUDGE_MODEL=gemini-2.5-flash
GEMINI_RESPONSE_MAX_TOKENS=512
GEMINI_JUDGE_MAX_TOKENS=300
GEMINI_TEMPERATURE=0.2

# Notes:
# - Do not commit your real GEMINI_API_KEY to source control.
# - Update model names if your Gemini plan supports newer or larger variants.
